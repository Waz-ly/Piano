TEXT 336 -1544 Left 2 !.lib 1N4148.lib
TEXT 344 -2192 Left 2 !.subckt LM358 inp inn vcc vee out PARAMS: avol=100k gbw=1Meg slew=0.3Meg vos=2m ib=20n iq=350u vlo=10m vhi=1.5 rout=100\n.param cc=100p\n.param gm={2*3.14159*gbw*cc}\n.param imax={slew*cc}\n.param rdc={avol/gm}\nRin inp inn 10Meg\nIq vcc vee {iq}\nIbp vee inp {ib}\nIbn vee inn {ib}\nG1 0 p VALUE={imax*tanh(gm*(V(inp,inn)+vos)/imax)}\nRp p 0 {rdc}\nCp p 0 {cc}\nBh ph 0 V=1.5*(V(vcc)-V(vee))\nBl pl 0 V=-1.5*(V(vcc)-V(vee))\nDh p ph DCL\nDl pl p DCL\n.model DCL D(Is=1e-14 N=1)\nB1 x 0 V=0.5*(V(vcc)+V(vee)+vlo-vhi)+0.5*(V(vcc)-V(vee)-vhi-vlo)*tanh(V(p)/(0.5*(V(vcc)-V(vee)-vhi-vlo)))\nRx x out {rout}\n.ends
